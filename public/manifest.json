{
  "manifest_version": 3,
  "name": "Vivians Portable Wardrobe Loader",
  "version": "0.1.0",
  "description": "Loader for Portable Wardrobe React floating panel",
  "permissions": ["storage", "scripting"],
  "content_scripts": [
    {
      "matches": [
        "https://bondageprojects.elementfx.com/*",
        "https://www.bondageprojects.elementfx.com/*",
        "https://bondage-europe.com/*",
        "https://www.bondage-europe.com/*",
        "https://bondage-asia.com/*",
        "https://www.bondage-asia.com/*",
        "http://localhost:5173/*",
        "http://localhost:5174/*"
      ],
      "js": ["dist/main.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://bondageprojects.elementfx.com/*",
    "https://bondage-europe.com/*",
    "https://bondage-asia.com/*",
    "http://localhost:5173/*",
    "http://localhost:5174/*"
  ]
}
